{
  "uid": "resultats-bf",
  "title": "RÉSULTATS-BF — supervision",
  "tags": ["resultats-bf"],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1, "type": "timeseries",
      "title": "Débit servi par le répartiteur (requêtes/s)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus-resultats" },
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0 }, "overrides": [] },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus-resultats" },
        "expr": "sum(rate(haproxy_frontend_http_requests_total{proxy=\"resultats\"}[10s]))",
        "legendFormat": "total" } ]
    },
    {
      "id": 2, "type": "timeseries",
      "title": "Débit par serveur applicatif (réponses/s)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus-resultats" },
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0 }, "overrides": [] },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus-resultats" },
        "expr": "sum by (server) (rate(haproxy_server_http_responses_total{proxy=\"applicatifs\"}[10s]))",
        "legendFormat": "{{server}}" } ]
    },
    {
      "id": 3, "type": "timeseries",
      "title": "Serveurs applicatifs en service selon HAProxy (1 = UP)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus-resultats" },
      "fieldConfig": { "defaults": { "unit": "none", "min": 0, "max": 1.1 }, "overrides": [] },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus-resultats" },
        "expr": "max by (server) (haproxy_server_status{proxy=\"applicatifs\",state=\"UP\"})",
        "legendFormat": "{{server}}" } ]
    },
    {
      "id": 4, "type": "timeseries",
      "title": "Machines joignables (node_exporter, 1 = joignable)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus-resultats" },
      "fieldConfig": { "defaults": { "unit": "none", "min": 0, "max": 1.1 }, "overrides": [] },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus-resultats" },
        "expr": "up{job=\"node\"}",
        "legendFormat": "{{nom}}" } ]
    },
    {
      "id": 5, "type": "timeseries",
      "title": "Réponses 5xx du répartiteur (par seconde)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus-resultats" },
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0 }, "overrides": [] },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus-resultats" },
        "expr": "sum(rate(haproxy_frontend_http_responses_total{proxy=\"resultats\",code=\"5xx\"}[10s]))",
        "legendFormat": "5xx" } ]
    },
    {
      "id": 6, "type": "timeseries",
      "title": "Utilisation CPU par machine (%)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus-resultats" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 }, "overrides": [] },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus-resultats" },
        "expr": "100 * (1 - avg by (nom) (rate(node_cpu_seconds_total{mode=\"idle\"}[15s])))",
        "legendFormat": "{{nom}}" } ]
    }
  ]
}